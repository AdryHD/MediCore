@model IEnumerable<MediCore.EF.Archivos>

@{
    ViewBag.Title = "Archivos";
}

<div class="page-heading">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <span class="section-eyebrow text-uppercase text-muted fw-bold small">
                ARCHIVOS DIGITALES
            </span>
            <h3 class="mb-1">Gestión de Archivos</h3>
            <p class="text-subtitle text-muted mb-0">
                Administración y consulta de documentos clínicos cargados.
            </p>
        </div>

        <div>
            <a href="@Url.Action("Create", "Archivos")" class="btn btn-primary">
                <i class="bi bi-cloud-upload me-1"></i>
                Nuevo Archivo
            </a>
        </div>
    </div>
</div>

<section class="section">


    <div class="card mb-4">
        <div class="card-body">
            @using (Html.BeginForm("Index", "Archivos", FormMethod.Get))
            {
                <div class="row">


                    <div class="col-md-6 mb-3 mb-md-0">
                        <label class="form-label fw-bold">Buscar archivo</label>
                        <input type="text"
                               name="buscar"
                               value="@ViewBag.Buscar"
                               class="form-control"
                               placeholder="Nombre del archivo..." />
                    </div>

                    <div class="col-md-4 mb-3 mb-md-0">
                        <label class="form-label fw-bold">Estado</label>
                        <select name="estado" class="form-select">
                            <option value="">Todos</option>
                            <option value="ACTIVO" @(ViewBag.Estado == "ACTIVO" ? "selected" : "")>ACTIVO</option>
                            <option value="INACTIVO" @(ViewBag.Estado == "INACTIVO" ? "selected" : "")>INACTIVO</option>
                        </select>
                    </div>

                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-funnel me-1"></i>
                            Filtrar
                        </button>
                    </div>

                </div>
            }
        </div>
    </div>


    <div class="card">
        <div class="card-header">
            <h4 class="card-title">
                <i class="bi bi-file-earmark-medical me-2"></i>
                Listado de Archivos
            </h4>
        </div>

        <div class="card-body">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Nombre</th>
                            <th>Tipo / MIME</th>
                            <th>Tamaño</th>
                            <th>Fecha Carga</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.id_archivo</td>

                                    <td class="fw-bold">
                                        <i class="bi bi-file-earmark-pdf text-danger me-1"></i>
                                        @item.nombre
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.tipo_mime) ? "N/A" : item.tipo_mime)
                                    </td>

                                    <td>
                                        @if (item.tamano_bytes > 0)
                                        {
                                            @(item.tamano_bytes >= 1048576
                                                ? string.Format("{0:F2} MB", (double)item.tamano_bytes / 1048576)
                                                : string.Format("{0:F2} KB", (double)item.tamano_bytes / 1024))
                                        }
                                        else
                                        {
                                            <span>0 Bytes</span>
                                        }
                                    </td>

                                    <td>
                                        @item.fecha_carga.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        @if (item.estado == "ACTIVO")
                                        {
                                            <span class="badge bg-success">ACTIVO</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@item.estado</span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group" role="group">

                                            <a href="@Url.Action("Details", "Archivos", new { id = item.id_archivo })"
                                               class="btn btn-sm btn-info text-white"
                                               title="Ver detalle">
                                                <i class="bi bi-eye"></i>
                                            </a>


                                            <a href="@Url.Action("Edit", "Archivos", new { id = item.id_archivo })"
                                               class="btn btn-sm btn-warning text-white"
                                               title="Editar archivo">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            @using (Html.BeginForm("CambiarEstado", "Archivos", FormMethod.Post, new { @class = "d-inline" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.id_archivo" />
                                                <input type="hidden" name="nuevoEstado" value="@(item.estado == "ACTIVO" ? "INACTIVO" : "ACTIVO")" />

                                                <button type="submit"
                                                        class="btn btn-sm @(item.estado == "ACTIVO" ? "btn-danger" : "btn-success") ms-1"
                                                        title="@(item.estado == "ACTIVO" ? "Desactivar" : "Activar")"
                                                        onclick="return confirm('¿Está seguro de cambiar el estado de este archivo?');">
                                                    <i class="bi @(item.estado == "ACTIVO" ? "bi-slash-circle" : "bi-check-circle")"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    <i class="bi bi-file-earmark-x fs-2 d-block mb-2"></i>
                                    No hay archivos registrados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</section>