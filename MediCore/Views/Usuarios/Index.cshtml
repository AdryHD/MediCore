@model IEnumerable<MediCore.Models.GestionUsuarioModel>
@{
    ViewBag.Title = "Usuarios";
    ViewBag.ActiveMenu = "Usuarios";

    var roles = ViewBag.Roles as System.Collections.Generic.List<MediCore.Models.RolItem>;
    int? usuarioActual = ViewBag.UsuarioActual as int?;
}

<style>
    .badge-status {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .25rem .65rem;
        border-radius: 50rem;
        font-size: .75rem;
        font-weight: 600;
        line-height: 1.4;
    }
    .badge-status.done       { background: #ecfdf5; color: #065f46; }
    .badge-status.canceled   { background: #fff5f5; color: #9b1c1c; }
    .badge-status.role-admin  { background: #ede9fe; color: #5b21b6; }
    .badge-status.role-doctor { background: #dcfce7; color: #166534; }
    .badge-status.role-recep  { background: #fef3c7; color: #92400e; }
    .badge-status.role-other  { background: #f1f5f9; color: #334155; }
    .btn-role {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .25rem .85rem;
        border-radius: 50rem;
        font-size: .78rem;
        font-weight: 600;
        border: 1.5px solid #93c5fd;
        background: #eff6ff;
        color: #1d4ed8;
        cursor: pointer;
        transition: all .2s;
        white-space: nowrap;
    }
    .btn-role:hover, .btn-role:focus {
        background: #dbeafe;
        border-color: #3b82f6;
        color: #1e3a8a;
        box-shadow: 0 0 0 3px rgba(59,130,246,.15);
        outline: none;
    }
</style>

<div class="page-heading">
    <div>
        <span class="section-eyebrow">ADMINISTRACIÓN</span>
        <h3>Usuarios y Roles</h3>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-light-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-light-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<section class="section">
    <div class="card">
        <div class="card-header">
            <h4><i class="bi bi-people-fill me-2" style="color:#01C0BA;"></i>Listado de Usuarios</h4>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Cédula</th>
                            <th>Estado</th>
                            <th>Rol actual</th>
                            <th class="text-end">Asignar rol</th>
                            <th class="text-center">Activar / Desactivar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Consecutivo</td>
                                    <td class="fw-semibold">@item.Nombre</td>
                                    <td>@item.Correo</td>
                                    <td>@item.Cedula</td>
                                    <td>
                                        @if (item.Estado)
                                        {
                                            <span class="badge-status done"><i class="bi bi-check-circle"></i>Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge-status canceled"><i class="bi bi-slash-circle"></i>Inactivo</span>
                                        }
                                    </td>
                                    <td>
                                        @{
                                            string rolKey = (item.NombreRol ?? "").ToUpper();
                                            string rolClass = rolKey.Contains("ADMIN") ? "role-admin"
                                                            : rolKey.Contains("DOCTOR") ? "role-doctor"
                                                            : rolKey.Contains("RECEP") ? "role-recep"
                                                            : "role-other";
                                        }
                                        <span class="badge-status @rolClass"><i class="bi bi-person-badge"></i>@item.NombreRol</span>
                                    </td>
                                    <td class="text-end">
                                        @using (Html.BeginForm("AsignarRol", "Usuarios", FormMethod.Post, new { style = "display:inline-flex; gap:.4rem; justify-content:flex-end;" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="idUsuario" value="@item.Consecutivo" />
                                            <select name="idRol" class="form-select form-select-sm" style="width:auto;">
                                                @if (roles != null)
                                                {
                                                    foreach (var rol in roles)
                                                    {
                                                        <option value="@rol.IdRol" selected="@(item.IdRol == rol.IdRol)">@rol.NombreRol</option>
                                                    }
                                                }
                                            </select>
                                            <button type="submit" class="btn-role" title="Guardar rol">
                                                <i class="bi bi-check-lg"></i>Guardar
                                            </button>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (usuarioActual.HasValue && usuarioActual.Value == item.Consecutivo)
                                        {
                                            <span class="text-muted small" title="No puedes modificar tu propia cuenta">
                                                <i class="bi bi-lock"></i>
                                            </span>
                                        }
                                        else
                                        {
                                            using (Html.BeginForm("CambiarEstado", "Usuarios", FormMethod.Post, new { style = "display:inline;" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="idUsuario" value="@item.Consecutivo" />
                                                if (item.Estado)
                                                {
                                                    <button type="submit" class="btn btn-action btn-light-danger" title="Desactivar usuario">
                                                        <i class="bi bi-toggle-off"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-action btn-light-success" title="Activar usuario">
                                                        <i class="bi bi-toggle-on"></i>
                                                    </button>
                                                }
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">No hay usuarios registrados.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
