
@model MediCore.EF.Archivos

@{
    ViewBag.Title = "Detalle del Archivo";
}

<div class="page-heading d-flex justify-content-between align-items-center mb-4">
    <div>
        <span class="section-eyebrow text-uppercase text-muted fw-bold small">
            EXPEDIENTE DIGITAL
        </span>
        <h3 class="mb-1">@Model.nombre</h3>
        <p class="text-subtitle text-muted mb-0">
            Detalles técnicos y contenido del archivo cargado.
        </p>
    </div>

    <div>
        <a href="@Url.Action("Index", "Archivos")" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Regresar
        </a>

        <a href="@Url.Action("Edit", "Archivos", new { id = Model.id_archivo })" class="btn btn-primary">
            <i class="bi bi-pencil-square me-1"></i>
            Editar Archivo
        </a>
    </div>
</div>

<section class="section">


    <div class="card mb-4">
        <div class="card-header">
            <h4 class="card-title">
                <i class="bi bi-file-earmark-medical me-2"></i>
                Información del Archivo
            </h4>
        </div>

        <div class="card-body">
            <div class="row">

                <div class="col-md-4 mb-3">
                    <small class="text-muted d-block">ID del Archivo</small>
                    <div class="fw-bold">#@Model.id_archivo</div>
                </div>

                <div class="col-md-4 mb-3">
                    <small class="text-muted d-block">Nombre del Archivo</small>
                    <div class="fw-bold">@Model.nombre</div>
                </div>

                <div class="col-md-4 mb-3">
                    <small class="text-muted d-block">Estado</small>
                    <div class="mt-1">
                        @if (Model.estado == "ACTIVO")
                        {
                            <span class="badge bg-success fs-6">ACTIVO</span>
                        }
                        else
                        {
                            <span class="badge bg-danger fs-6">@Model.estado</span>
                        }
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <small class="text-muted d-block">Tipo MIME / Formato</small>
                    <div class="fw-bold">
                        @(string.IsNullOrWhiteSpace(Model.tipo_mime) ? "No especificado" : Model.tipo_mime)
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <small class="text-muted d-block">Tamaño</small>
                    <div class="fw-bold">
                        @if (Model.tamano_bytes > 0)
                        {

                            @(Model.tamano_bytes >= 1048576
                                ? string.Format("{0:F2} MB", (double)Model.tamano_bytes / 1048576)
                                : string.Format("{0:F2} KB", (double)Model.tamano_bytes / 1024))
                        }
                        else
                        {
                            <span>0 Bytes</span>
                        }
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <small class="text-muted d-block">Fecha de Carga</small>
                    <div class="fw-bold">
                        @Model.fecha_carga.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h4 class="card-title">
                <i class="bi bi-link-45deg me-2"></i>
                Origen y Relación
            </h4>
        </div>

        <div class="card-body">
            <div class="row">

                <div class="col-md-6 mb-3">
                    <small class="text-muted d-block">Expediente Asignado</small>
                    <div class="fw-bold">
                        @if (Model.Expedientes != null && Model.Expedientes.Pacientes != null)
                        {
                            <a href="@Url.Action("Details", "Archivos", new { id = Model.id_expediente })">
                                <i class="bi bi-folder2-open me-1"></i>
                                @Model.Expedientes.Pacientes.nombre_completo (ID Expediente: #@Model.id_expediente)
                            </a>
                        }
                        else if (Model.id_expediente.HasValue)
                        {
                            <span>Expediente #@Model.id_expediente</span>
                        }
                        else
                        {
                            <span class="text-muted">Sin expediente asociado</span>
                        }
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <small class="text-muted d-block">Subido por (Usuario)</small>
                    <div class="fw-bold">
                        @if (Model.tbUsuario != null)
                        {
                            <span>
                                <i class="bi bi-person-check me-1"></i>
                                @Model.tbUsuario.Nombre (ID Usuario: #@Model.id_usuario)
                            </span>
                        }
                        else if (Model.id_usuario.HasValue)
                        {
                            <span>Usuario #@Model.id_usuario</span>
                        }
                        else
                        {
                            <span class="text-muted">Usuario no identificado</span>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h4 class="card-title">
                <i class="bi bi-download me-2"></i>
                Contenido del Archivo
            </h4>
        </div>

        <div class="card-body text-center py-4">
            @if (Model.contenido != null && Model.contenido.Length > 0)
            {
                <i class="bi bi-file-earmark-check text-success fs-1"></i>
                <p class="mt-2 mb-3">El archivo binario se encuentra almacenado correctamente en el sistema.</p>

                <a href="@Url.Action("Descargar", "Archivos", new { id = Model.id_archivo })" class="btn btn-outline-primary">
                    <i class="bi bi-download me-1"></i>
                    Descargar Archivo
                </a>
            }
            else
            {
                <i class="bi bi-file-earmark-x text-muted fs-1"></i>
                <p class="mt-2 mb-0 text-muted">
                    Este registro no contiene datos binarios o el archivo está vacío.
                </p>
            }
        </div>
    </div>

</section>