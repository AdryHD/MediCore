@model IEnumerable<MediCore.EF.HistorialMedico>

@{
    ViewBag.Title = "Historial Médico";
}

<div class="page-heading">

    <div>

        <span class="section-eyebrow">
            HISTORIAL CLÍNICO
        </span>

        <h3>Historial Médico</h3>

        <p class="text-subtitle text-muted mb-0">
            Consulta del historial clínico de los pacientes.
        </p>

    </div>

</div>


<section class="section">

    <!-- FILTROS -->

    <div class="card mb-4">

        <div class="card-body">

            @using (Html.BeginForm(
                "Index",
                "HistorialMedico",
                FormMethod.Get))
            {
                <div class="row">

                    <div class="col-md-4 mb-3">

                        <label>Paciente</label>

                        @Html.DropDownList(
                            "idPaciente",
                            (SelectList)ViewBag.Pacientes,
                            "Todos",
                            new { @class = "form-select" })

                    </div>


                    <div class="col-md-4 mb-3">

                        <label>Doctor</label>

                        @Html.DropDownList(
                            "idDoctor",
                            (SelectList)ViewBag.Doctores,
                            "Todos",
                            new { @class = "form-select" })

                    </div>


                    <div class="col-md-4 mb-3">

                        <label>Especialidad</label>

                        @Html.DropDownList(
                            "idEspecialidad",
                            (SelectList)ViewBag.Especialidades,
                            "Todas",
                            new { @class = "form-select" })

                    </div>

                </div>


                <div class="row">

                    <div class="col-md-4 mb-3">

                        <label>Desde</label>

                        <input type="date"
                               name="fechaDesde"
                               class="form-control"
                               value="@(ViewBag.FechaDesde != null
                                    ? ((DateTime)ViewBag.FechaDesde)
                                        .ToString("yyyy-MM-dd")
                                    : "")" />

                    </div>


                    <div class="col-md-4 mb-3">

                        <label>Hasta</label>

                        <input type="date"
                               name="fechaHasta"
                               class="form-control"
                               value="@(ViewBag.FechaHasta != null
                                    ? ((DateTime)ViewBag.FechaHasta)
                                        .ToString("yyyy-MM-dd")
                                    : "")" />

                    </div>


                    <div class="col-md-4 d-flex align-items-end mb-3">

                        <button type="submit"
                                class="btn btn-primary w-100">

                            <i class="bi bi-funnel me-1"></i>
                            Filtrar

                        </button>

                    </div>

                </div>
            }

        </div>

    </div>


    <!-- HISTORIAL -->

    <div class="card">

        <div class="card-header">

            <h4 class="card-title">

                <i class="bi bi-clock-history me-2"></i>
                Consultas Registradas

            </h4>

        </div>


        <div class="card-body">

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }


            <div class="table-responsive">

                <table class="table table-striped table-hover">

                    <thead class="table-light">

                        <tr>

                            <th>Fecha</th>

                            <th>Paciente</th>

                            <th>Doctor</th>

                            <th>Especialidad</th>

                            <th>Diagnóstico</th>

                            <th class="text-center">
                                Acciones
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @item.fecha_consulta.ToString(
                                            "dd/MM/yyyy HH:mm")
                                    </td>


                                    <td>
                                        @item.Expedientes.Pacientes.nombre_completo
                                    </td>


                                    <td>
                                        @item.Doctores.nombre_completo
                                    </td>


                                    <td>
                                        @item.Doctores.Especialidades.nombre
                                    </td>


                                    <td>
                                        @item.diagnostico
                                    </td>


                                    <td class="text-center">

                                        <a href="@Url.Action(
                                                    "Details",
                                                    "HistorialMedico",
                                                    new
                                                    {
                                                        id = item.id_historial
                                                    })"
                                           class="btn btn-sm btn-info"
                                           title="Ver consulta">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="6"
                                    class="text-center text-muted py-4">

                                    <i class="bi bi-clipboard2-x fs-2"></i>

                                    <br />

                                    No se encontraron registros
                                    en el historial médico.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</section>