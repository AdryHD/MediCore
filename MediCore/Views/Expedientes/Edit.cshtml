
@model MediCore.Models.ExpedienteEditModel
@{
    ViewBag.Title = "Editar Expediente";
    ViewBag.ActiveMenu = "Expedientes";
}

<div class="page-heading">
    <div>
        <span class="section-eyebrow">EXPEDIENTES</span>
        <h3>Editar Expediente</h3>
    </div>
    <div>
        <a href="@Url.Action("Details", "Expedientes", new { id = Model.IdExpediente })" class="btn btn-light-secondary">
            <i class="bi bi-arrow-left me-1"></i>Cancelar
        </a>
    </div>
</div>


<section class="section">

    <div class="card">

        <div class="card-header">

            <h4><i class="bi bi-folder2-open me-2" style="color:#01C0BA;"></i>Información del Expediente</h4>

        </div>

        <div class="card-body">

            @using (Html.BeginForm("Edit", "Expedientes", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(m => m.IdExpediente)

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Paciente
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@Model.NombrePaciente"
                               readonly />

                    </div>


                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Cédula
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@Model.CedulaPaciente"
                               readonly />

                    </div>

                </div>


                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Tipo de sangre
                        </label>

                        @Html.DropDownListFor(
                            m => m.TipoSangre,
                            new SelectList(
                                new[]
                                {
                                    "A+",
                                    "A-",
                                    "B+",
                                    "B-",
                                    "AB+",
                                    "AB-",
                                    "O+",
                                    "O-"
                                },
                                Model.TipoSangre
                            ),
                            "-- Seleccione --",
                            new { @class = "form-select" }
                        )

                    </div>


                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Fecha de apertura
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@Model.FechaApertura.ToString("dd/MM/yyyy")"
                               readonly />

                    </div>

                </div>


                <div class="mb-3">

                    <label class="form-label">
                        Alergias
                    </label>

                    @Html.TextAreaFor(
                        m => m.Alergias,
                        new
                        {
                            @class = "form-control",
                            rows = "4",
                            placeholder = "Ingrese las alergias conocidas del paciente..."
                        }
                    )

                </div>


                <div class="mb-3">

                    <label class="form-label">
                        Antecedentes médicos
                    </label>

                    @Html.TextAreaFor(
                        m => m.Antecedentes,
                        new
                        {
                            @class = "form-control",
                            rows = "5",
                            placeholder = "Ingrese los antecedentes médicos relevantes..."
                        }
                    )

                </div>


                <div class="text-end mt-4">

                    <a href="@Url.Action("Details", "Expedientes", new { id = Model.IdExpediente })" class="btn btn-light-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-circle"></i>
                        Guardar Cambios

                    </button>

                </div>
            }

        </div>

    </div>

</section>