@model MediCore.Models.ArchivosFormModel
@{
    ViewBag.Title = "Editar Archivo";
    ViewBag.ActiveMenu = "Archivos";
}

<div class="page-heading">
    <div>
        <span class="section-eyebrow">ARCHIVOS DIGITALES</span>
        <h3>Editar Archivo</h3>
    </div>
    <div>
        <a href="@Url.Action("Index", "Archivos")" class="btn btn-light-secondary">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
    </div>
</div>

<section class="section">
    <div class="card">
        <div class="card-header">
            <h4 class="card-title">
                <i class="bi bi-file-earmark-text me-2"></i>
                Información del Archivo
            </h4>
        </div>

        <div class="card-body">
            @using (Html.BeginForm("Edit", "Archivos", FormMethod.Post, new { enctype = "multipart/form-data", id = "formArchivo" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                @Html.HiddenFor(m => m.Id_Archivo)
                @Html.HiddenFor(m => m.Id_Usuario)

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Expediente / Paciente</label>
                        @Html.DropDownListFor(
                            m => m.Id_Expediente,
                            (IEnumerable<SelectListItem>)ViewBag.ExpedientesList,
                            "-- Seleccione un paciente/expediente --",
                            new { @class = "form-select" }
                        )
                        @Html.ValidationMessageFor(m => m.Id_Expediente, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Nombre del Archivo</label>
                        @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", placeholder = "Ej: Examen_Sangre_JuanPerez.pdf" })
                        @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Tipo MIME / Formato</label>
                        @Html.TextBoxFor(m => m.Tipo_mime, new { @class = "form-control", placeholder = "Ej: application/pdf" })
                        @Html.ValidationMessageFor(m => m.Tipo_mime, "", new { @class = "text-danger small" })
                    </div>


                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Estado</label>
                        @Html.DropDownListFor(
                            m => m.Estado,
                            new SelectList(
                                new[]
                                {
                                    new { Value = "ACTIVO", Text = "ACTIVO" },
                                    new { Value = "INACTIVO", Text = "INACTIVO" }
                                },
                                "Value",
                                "Text",
                                Model.Estado
                            ),
                            "-- Seleccione un estado --",
                            new { @class = "form-select" }
                        )
                        @Html.ValidationMessageFor(m => m.Estado, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Fecha de Carga Original</label>
                        <input type="text"
                               class="form-control"
                               value="@Model.Fecha_carga.ToString("dd/MM/yyyy HH:mm")"
                               readonly />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Reemplazar Documento (Opcional)</label>
                        <input type="file" name="archivoSubido" class="form-control" />
                        <small class="text-muted d-block mt-1">
                            Deje este campo vacío si no desea reemplazar el binario actual.
                        </small>
                    </div>
                </div>


                <div class="text-end mt-4">
                    <a href="@Url.Action("Index", "Archivos")" class="btn btn-light-secondary me-2">
                        <i class="bi bi-arrow-left me-1"></i>Cancelar
                    </a>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle me-1"></i>
                        Guardar Cambios
                    </button>
                </div>
            }
        </div>
    </div>
</section>