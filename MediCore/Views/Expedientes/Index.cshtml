@model IEnumerable<MediCore.EF.Expedientes>

@{
    ViewBag.Title = "Expedientes";
}

<div class="page-heading">

    <div class="d-flex justify-content-between align-items-start">

        <div>
            <span class="section-eyebrow">
                EXPEDIENTES
            </span>

            <h3>Expedientes Clínicos</h3>

            <p class="text-subtitle text-muted mb-0">
                Gestión de expedientes clínicos de los pacientes.
            </p>
        </div>

       

    </div>

</div>


<section class="section">

    <!-- FILTROS -->
    <div class="card mb-4">

        <div class="card-body">

            @using (Html.BeginForm("Index", "Expedientes", FormMethod.Get))
            {
                <div class="row">

                    <div class="col-md-6">

                        <label>Buscar paciente</label>

                        <input type="text"
                               name="buscar"
                               value="@ViewBag.Buscar"
                               class="form-control"
                               placeholder="Nombre o cédula" />

                    </div>


                    <div class="col-md-4">

                        <label>Tipo de sangre</label>

                        <select name="tipoSangre"
                                class="form-select">

                            <option value="">Todos</option>

                            <option value="A+">A+</option>
                            <option value="A-">A-</option>
                            <option value="B+">B+</option>
                            <option value="B-">B-</option>
                            <option value="AB+">AB+</option>
                            <option value="AB-">AB-</option>
                            <option value="O+">O+</option>
                            <option value="O-">O-</option>

                        </select>

                    </div>


                    <div class="col-md-2 d-flex align-items-end">

                        <button type="submit"
                                class="btn btn-primary w-100">

                            <i class="bi bi-funnel"></i>
                            Filtrar

                        </button>

                    </div>

                </div>
            }

        </div>

    </div>


    <!-- LISTADO -->
    <div class="card">

        <div class="card-header">

            <h4 class="card-title">

                <i class="bi bi-folder2-open"></i>
                Listado de Expedientes

            </h4>

        </div>


        <div class="card-body">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">

                    @TempData["Success"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }


            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">

                    @TempData["Error"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }


            <div class="table-responsive">

                <table class="table table-striped table-hover">

                    <thead class="table-light">

                        <tr>

                            <th>#</th>

                            <th>Paciente</th>

                            <th>Cédula</th>

                            <th>Tipo de sangre</th>

                            <th>Fecha de apertura</th>

                            <th>Consultas</th>

                            <th class="text-center">
                                Acciones
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @item.id_expediente
                                    </td>


                                    <td>
                                        @item.Pacientes.nombre_completo
                                    </td>


                                    <td>
                                        @item.Pacientes.cedula
                                    </td>


                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(item.tipo_sangre))
                                        {
                                            <span class="badge bg-danger">
                                                @item.tipo_sangre
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No registrado
                                            </span>
                                        }

                                    </td>


                                    <td>
                                        @item.fecha_apertura.ToString("dd/MM/yyyy")
                                    </td>


                                    <td>

                                        <span class="badge bg-primary">

                                            @item.HistorialMedico.Count

                                        </span>

                                    </td>


                                    <td class="text-center">

                                        <a href="@Url.Action("Details", "Expedientes", new { id = item.id_expediente })"
                                           class="btn btn-sm btn-info"
                                           title="Ver expediente">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                        <a href="@Url.Action(
                                            "Edit",
                                            "Expedientes",
                                            new { id = item.id_expediente })"
                                            class="btn btn-sm btn-warning"
                                           title="Editar expediente">

                                            <i class="bi bi-pencil-square"></i>

                                        </a>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="7"
                                    class="text-center text-muted py-4">

                                    <i class="bi bi-folder-x fs-4"></i>

                                    <br />

                                    No hay expedientes registrados.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</section>