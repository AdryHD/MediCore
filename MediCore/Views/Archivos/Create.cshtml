@model MediCore.Models.ArchivosFormModel
@{
    ViewBag.Title = "Agregar Archivo";
    ViewBag.ActiveMenu = "Archivos";
}

<div class="page-heading">
    <div>
        <span class="section-eyebrow">ARCHIVOS DIGITALES</span>
        <h3>Registrar Nuevo Archivo</h3>
    </div>
    <div>
        <a href="@Url.Action("Index", "Archivos")" class="btn btn-light-secondary">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
    </div>
</div>

<section class="section">
    <div class="card">
        <div class="card-header">
            <h4 class="card-title">
                <i class="bi bi-cloud-upload me-2"></i>
                Datos del Archivo
            </h4>
        </div>

        <div class="card-body">
            @using (Html.BeginForm("Create", "Archivos", FormMethod.Post, new { enctype = "multipart/form-data", id = "formArchivo" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Expediente / Paciente</label>
                        @Html.DropDownListFor(
                            m => m.Id_Expediente,
                            (IEnumerable<SelectListItem>)ViewBag.ExpedientesList,
                            "-- Seleccione un paciente/expediente --",
                            new { @class = "form-select" }
                        )
                        @Html.ValidationMessageFor(m => m.Id_Expediente, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Nombre del Archivo</label>
                        @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", placeholder = "Ej: Resultado_Laboratorio.pdf" })
                        @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Seleccionar Archivo</label>
                        <div class="input-group">
                            <button type="button" class="btn btn-primary" onclick="document.getElementById('archivoInput').click()">
                                <i class="bi bi-folder2-open me-1"></i>Elegir archivo
                            </button>
                            <span class="form-control text-muted" id="archivoNombre" style="cursor:pointer;" onclick="document.getElementById('archivoInput').click()">
                                Imágenes (JPG, PNG), PDF, Word, Excel...
                            </span>
                        </div>
                        <input type="file" id="archivoInput" name="archivoSubido"
                               accept=".jpg,.jpeg,.png,.gif,.bmp,.webp,.pdf,.doc,.docx,.xls,.xlsx,.txt"
                               style="display:none;"
                               onchange="document.getElementById('archivoNombre').textContent = this.files.length > 0 ? this.files[0].name : 'Imágenes (JPG, PNG), PDF, Word, Excel...'; document.getElementById('archivoNombre').classList.toggle('text-muted', this.files.length === 0); document.getElementById('archivoNombre').classList.toggle('text-dark', this.files.length > 0);" />
                    </div>

                </div>

                <div class="text-end mt-4">
                    <a href="@Url.Action("Index", "Archivos")" class="btn btn-light-secondary me-2">
                        <i class="bi bi-arrow-left me-1"></i>Cancelar
                    </a>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle me-1"></i>
                        Guardar Archivo
                    </button>
                </div>
            }
        </div>
    </div>
</section>