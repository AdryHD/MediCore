@model MediCore.EF.Citas
@{
    ViewBag.Title = "Detalle de la Cita";
    ViewBag.ActiveMenu = "Citas";
}

<div class="page-heading">
    <div>
        <span class="section-eyebrow">GESTIÓN MÉDICA</span>
        <h3>Detalle de la Cita</h3>
    </div>
    <div>
        <a href="@Url.Action("Index", "Citas")" class="btn btn-light-secondary">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
    </div>
</div>

<section class="section">
    <div class="card">
        <div class="card-header">
            <h4><i class="bi bi-calendar2-check me-2" style="color:#01C0BA;"></i>Información de la Cita</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <small class="text-muted">Paciente</small>
                    <div class="fw-semibold">@Model.Pacientes.nombre_completo</div>
                </div>
                <div class="col-md-6 mb-3">
                    <small class="text-muted">Doctor</small>
                    <div class="fw-semibold">@Model.Doctores.nombre_completo</div>
                </div>
                <div class="col-md-6 mb-3">
                    <small class="text-muted">Especialidad</small>
                    <div class="fw-semibold">@Model.Doctores.Especialidades.nombre</div>
                </div>
                <div class="col-md-6 mb-3">
                    <small class="text-muted">Fecha</small>
                    <div class="fw-semibold">@Model.fecha_cita.ToString("dd/MM/yyyy")</div>
                </div>
                <div class="col-md-6 mb-3">
                    <small class="text-muted">Hora</small>
                    <div class="fw-semibold">@Model.fecha_cita.ToString("HH:mm")</div>
                </div>
                <div class="col-md-6 mb-3">
                    <small class="text-muted">Duración</small>
                    <div class="fw-semibold">@Model.duracion_min minutos</div>
                </div>
                <div class="col-md-12 mb-3">
                    <small class="text-muted">Motivo</small>
                    <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.motivo) ? "No registrado" : Model.motivo)</div>
                </div>
                <div class="col-md-6 mb-3">
                    <small class="text-muted">Estado</small>
                    <div class="mt-1">
                        @if (Model.estado == "PENDIENTE")
                        {
                            <span class="badge-status pending"><i class="bi bi-hourglass-split"></i>Pendiente</span>
                        }
                        else if (Model.estado == "ATENDIDA")
                        {
                            <span class="badge-status done"><i class="bi bi-check-circle"></i>Atendida</span>
                        }
                        else
                        {
                            <span class="badge-status canceled"><i class="bi bi-slash-circle"></i>Cancelada</span>
                        }
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <small class="text-muted">Fecha de registro</small>
                    <div class="fw-semibold">@Model.fecha_creacion.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
            </div>
        </div>
    </div>
</section>