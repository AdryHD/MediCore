@model MediCore.Models.ExpedienteDetalleModel
@{
    ViewBag.Title = "Detalle del Expediente";
    ViewBag.ActiveMenu = "Expedientes";
}

<div class="page-heading">

    <div>
        <span class="section-eyebrow">
            EXPEDIENTE CLÍNICO
        </span>

        <h3>@Model.NombrePaciente</h3>
    </div>

    <div>
        <a href="@Url.Action("Index", "Expedientes")" class="btn btn-light-secondary">
            <i class="bi bi-arrow-left me-1"></i>Regresar
        </a>
        <a href="@Url.Action("Edit", "Expedientes", new { id = Model.IdExpediente })" class="btn btn-primary">

            <i class="bi bi-pencil-square me-1"></i>
            Editar Expediente

        </a>
    </div>

</div>


<section class="section">

    <div class="card mb-4">
        <div class="card-header">
            <h4><i class="bi bi-person-vcard me-2" style="color:#01C0BA;"></i>Datos del Paciente</h4>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4 mb-3">
                    <small class="text-muted">Nombre completo</small>
                    <div class="fw-bold">
                        @Model.NombrePaciente
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <small class="text-muted">Cédula</small>
                    <div class="fw-bold">
                        @Model.CedulaPaciente
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <small class="text-muted">Fecha de nacimiento</small>
                    <div class="fw-bold">
                        @Model.FechaNacimientoPaciente.ToString("dd/MM/yyyy")
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <small class="text-muted">Sexo</small>
                    <div class="fw-bold">
                        @Model.SexoPaciente
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <small class="text-muted">Teléfono</small>
                    <div class="fw-bold">
                        @(string.IsNullOrWhiteSpace(Model.TelefonoPaciente)
                            ? "No registrado"
                            : Model.TelefonoPaciente)
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <small class="text-muted">Correo electrónico</small>
                    <div class="fw-bold">
                        @(string.IsNullOrWhiteSpace(Model.CorreoPaciente)
                            ? "No registrado"
                            : Model.CorreoPaciente)
                    </div>
                </div>

                <div class="col-12">
                    <small class="text-muted">Dirección</small>
                    <div class="fw-bold">
                        @(string.IsNullOrWhiteSpace(Model.DireccionPaciente)
                            ? "No registrada"
                            : Model.DireccionPaciente)
                    </div>
                </div>

            </div>

        </div>

    </div>


    <div class="card mb-4">
        <div class="card-header">
            <h4><i class="bi bi-heart me-2" style="color:#01C0BA;"></i>Información Clínica</h4>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4 mb-3">

                    <small class="text-muted">
                        Tipo de sangre
                    </small>

                    <div class="mt-1">

                        @if (!string.IsNullOrWhiteSpace(Model.TipoSangre))
                        {
                            <span class="badge-status pending"><i class="bi bi-droplet-fill"></i>@Model.TipoSangre</span>
                        }
                        else
                        {
                            <span class="text-muted">
                                No registrado
                            </span>
                        }

                    </div>

                </div>


                <div class="col-md-4 mb-3">

                    <small class="text-muted">
                        Fecha de apertura
                    </small>

                    <div class="fw-bold">
                        @Model.FechaApertura.ToString("dd/MM/yyyy")
                    </div>

                </div>


                <div class="col-md-4 mb-3">

                    <small class="text-muted">
                        Consultas registradas
                    </small>

                    <div>
                        <span class="badge-status done"><i class="bi bi-clipboard2-pulse"></i>@Model.ConsultasCount</span>
                    </div>

                </div>

            </div>


            <hr />


            <div class="mb-4">

                <h6>
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    Alergias
                </h6>

                <p class="mb-0">
                    @(string.IsNullOrWhiteSpace(Model.Alergias)
                        ? "No se han registrado alergias."
                        : Model.Alergias)
                </p>

            </div>


            <div>

                <h6>
                    <i class="bi bi-clipboard2-pulse me-1"></i>
                    Antecedentes médicos
                </h6>

                <p class="mb-0">
                    @(string.IsNullOrWhiteSpace(Model.Antecedentes)
                        ? "No se han registrado antecedentes médicos."
                        : Model.Antecedentes)
                </p>

            </div>

        </div>

    </div>


    <div class="card">
        <div class="card-header">
            <h4><i class="bi bi-clock-history me-2" style="color:#01C0BA;"></i>Historial Médico</h4>
        </div>
        <div class="card-body p-0">
            @if (Model.Historial != null && Model.Historial.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Doctor</th>
                                <th>Diagnóstico</th>
                                <th>Próxima cita</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var historial in Model.Historial)
                            {
                                <tr>
                                    <td>@historial.FechaConsulta.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@historial.NombreDoctor</td>
                                    <td>@historial.Diagnostico</td>
                                    <td>
                                        @if (historial.ProximaCita.HasValue)
                                        {
                                            @historial.ProximaCita.Value.ToString("dd/MM/yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a href="@Url.Action("Details", "HistorialMedico", new { id = historial.IdHistorial })" class="btn btn-action btn-light-secondary" title="Ver consulta">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state" style="padding:2rem;">
                    <div class="empty-state-icon-wrap">
                        <i class="bi bi-clipboard2-x"></i>
                    </div>
                    <p class="empty-state-title">Sin consultas registradas</p>
                    <p class="empty-state-sub">Este paciente todavía no tiene consultas en su historial médico.</p>
                </div>
            }
        </div>
    </div>

</section>