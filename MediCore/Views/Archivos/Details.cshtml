@model MediCore.Models.ArchivoDetalleModel
@{
    ViewBag.Title = "Detalle del Archivo";
    ViewBag.ActiveMenu = "Archivos";
}

<div class="page-heading">
    <div>
        <span class="section-eyebrow">ARCHIVOS DIGITALES</span>
        <h3>@Model.Nombre</h3>
    </div>
    <div>
        <a href="@Url.Action("Index", "Archivos")" class="btn btn-light-secondary">
            <i class="bi bi-arrow-left me-1"></i>Regresar
        </a>
        <a href="@Url.Action("Edit", "Archivos", new { id = Model.IdArchivo })" class="btn btn-primary">
            <i class="bi bi-pencil-square me-1"></i>Editar
        </a>
    </div>
</div>

<section class="section">


    <div class="card mb-4">
        <div class="card-header">
            <h4><i class="bi bi-file-earmark-medical me-2" style="color:#01C0BA;"></i>Información del Archivo</h4>
        </div>

        <div class="card-body">
            <div class="row">

                <div class="col-md-4 mb-3">
                    <small class="text-muted d-block">ID del Archivo</small>
                    <div class="fw-bold">#@Model.IdArchivo</div>
                </div>

                <div class="col-md-4 mb-3">
                    <small class="text-muted d-block">Nombre del Archivo</small>
                    <div class="fw-bold">@Model.Nombre</div>
                </div>

                <div class="col-md-4 mb-3">
                    <small class="text-muted d-block">Estado</small>
                    <div class="mt-1">
                        @if (Model.Estado == "ACTIVO")
                        {
                            <span class="badge-status done"><i class="bi bi-check-circle"></i>Activo</span>
                        }
                        else
                        {
                            <span class="badge-status canceled"><i class="bi bi-slash-circle"></i>Inactivo</span>
                        }
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <small class="text-muted d-block">Tipo MIME / Formato</small>
                    <div class="fw-bold">
                        @(string.IsNullOrWhiteSpace(Model.TipoMime) ? "No especificado" : Model.TipoMime)
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <small class="text-muted d-block">Tamaño</small>
                    <div class="fw-bold">
                        @if (Model.TamanioBytes > 0)
                        {

                            @(Model.TamanioBytes >= 1048576
                                ? string.Format("{0:F2} MB", (double)Model.TamanioBytes / 1048576)
                                : string.Format("{0:F2} KB", (double)Model.TamanioBytes / 1024))
                        }
                        else
                        {
                            <span>0 Bytes</span>
                        }
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <small class="text-muted d-block">Fecha de Carga</small>
                    <div class="fw-bold">
                        @Model.FechaCarga.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h4><i class="bi bi-link-45deg me-2" style="color:#01C0BA;"></i>Origen y Relación</h4>
        </div>

        <div class="card-body">
            <div class="row">

                <div class="col-md-6 mb-3">
                    <small class="text-muted d-block">Expediente Asignado</small>
                    <div class="fw-bold">
                        @if (Model.NombrePaciente != null)
                        {
                            <a href="@Url.Action("Details", "Archivos", new { id = Model.IdExpediente })">
                                <i class="bi bi-folder2-open me-1"></i>
                                @Model.NombrePaciente (ID Expediente: #@Model.IdExpediente)
                            </a>
                        }
                        else if (Model.IdExpediente.HasValue)
                        {
                            <span>Expediente #@Model.IdExpediente</span>
                        }
                        else
                        {
                            <span class="text-muted">Sin expediente asociado</span>
                        }
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <small class="text-muted d-block">Subido por (Usuario)</small>
                    <div class="fw-bold">
                        @if (Model.NombreUsuario != null)
                        {
                            <span>
                                <i class="bi bi-person-check me-1"></i>
                                @Model.NombreUsuario (ID Usuario: #@Model.IdUsuario)
                            </span>
                        }
                        else if (Model.IdUsuario.HasValue)
                        {
                            <span>Usuario #@Model.IdUsuario</span>
                        }
                        else
                        {
                            <span class="text-muted">Usuario no identificado</span>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h4><i class="bi bi-download me-2" style="color:#01C0BA;"></i>Contenido del Archivo</h4>
        </div>

        <div class="card-body text-center py-4">
            @if (Model.TieneContenido)
            {
                <i class="bi bi-file-earmark-check text-success fs-1"></i>
                <p class="mt-2 mb-3">El archivo binario se encuentra almacenado correctamente en el sistema.</p>

                <a href="@Url.Action("Descargar", "Archivos", new { id = Model.IdArchivo })" class="btn btn-primary">
                    <i class="bi bi-download me-1"></i>
                    Descargar Archivo
                </a>
            }
            else
            {
                <i class="bi bi-file-earmark-x text-muted fs-1"></i>
                <p class="mt-2 mb-0 text-muted">
                    Este registro no contiene datos binarios o el archivo está vacío.
                </p>
            }
        </div>
    </div>

</section>