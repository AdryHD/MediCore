@model MediCore.Models.ArchivoDetalleModel
@{
    ViewBag.Title = "Detalle del Archivo";
    ViewBag.ActiveMenu = "Archivos";
}

<div class="page-heading">
    <div>
        <span class="section-eyebrow">ARCHIVOS DIGITALES</span>
        <h3>@Model.Nombre</h3>
    </div>
    <div>
        <a href="@Url.Action("Index", "Archivos")" class="btn btn-light-secondary">
            <i class="bi bi-arrow-left me-1"></i>Regresar
        </a>
        <a href="@Url.Action("Edit", "Archivos", new { id = Model.IdArchivo })" class="btn btn-primary">
            <i class="bi bi-pencil-square me-1"></i>Editar
        </a>
    </div>
</div>

<section class="section">


    <div class="card mb-4">
        <div class="card-header">
            <h4><i class="bi bi-file-earmark-medical me-2" style="color:#01C0BA;"></i>Información del Archivo</h4>
        </div>

        <div class="card-body">
            <div class="row">

                @if (Model.NombrePaciente != null)
                {
                    <div class="col-12 mb-3">
                        <small class="text-muted d-block">Paciente</small>
                        <div class="fw-bold fs-5"><i class="bi bi-person-circle me-1" style="color:#01C0BA;"></i>@Model.NombrePaciente</div>
                    </div>
                }

                <div class="col-md-4 mb-3">
                    <small class="text-muted d-block">ID del Archivo</small>
                    <div class="fw-bold">#@Model.IdArchivo</div>
                </div>

                <div class="col-md-4 mb-3">
                    <small class="text-muted d-block">Nombre del Archivo</small>
                    <div class="fw-bold">@Model.Nombre</div>
                </div>

                <div class="col-md-4 mb-3">
                    <small class="text-muted d-block">Estado</small>
                    <div class="mt-1">
                        @if (Model.Estado == "ACTIVO")
                        {
                            <span class="badge-status done"><i class="bi bi-check-circle"></i>Activo</span>
                        }
                        else
                        {
                            <span class="badge-status canceled"><i class="bi bi-slash-circle"></i>Inactivo</span>
                        }
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <small class="text-muted d-block">Tipo MIME / Formato</small>
                    <div class="fw-bold">
                        @(string.IsNullOrWhiteSpace(Model.TipoMime) ? "No especificado" : Model.TipoMime)
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <small class="text-muted d-block">Tamaño</small>
                    <div class="fw-bold">
                        @if (Model.TamanioBytes > 0)
                        {

                            @(Model.TamanioBytes >= 1048576
                                ? string.Format("{0:F2} MB", (double)Model.TamanioBytes / 1048576)
                                : string.Format("{0:F2} KB", (double)Model.TamanioBytes / 1024))
                        }
                        else
                        {
                            <span>0 Bytes</span>
                        }
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <small class="text-muted d-block">Fecha de Carga</small>
                    <div class="fw-bold">
                        @Model.FechaCarga.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h4><i class="bi bi-download me-2" style="color:#01C0BA;"></i>Contenido del Archivo</h4>
        </div>

        <div class="card-body py-4">
            @if (Model.TieneContenido)
            {
                if (!string.IsNullOrEmpty(Model.TipoMime) && Model.TipoMime.StartsWith("image/"))
                {
                    <div class="d-flex flex-column align-items-center gap-3">
                        <div style="background:#f8f9fa; border:2px solid #dee2e6; border-radius:12px; padding:12px; display:inline-block; box-shadow:0 2px 8px rgba(0,0,0,0.08);">
                            <img src="@Url.Action("Descargar", "Archivos", new { id = Model.IdArchivo })"
                                 alt="@Model.Nombre"
                                 style="width:220px; height:220px; object-fit:contain; border-radius:8px; display:block;" />
                        </div>
                        <p class="text-muted small mb-0"><i class="bi bi-image me-1"></i>Vista previa de la imagen</p>
                        <a href="@Url.Action("Descargar", "Archivos", new { id = Model.IdArchivo })"
                           class="btn btn-primary">
                            <i class="bi bi-download me-1"></i>Descargar Archivo
                        </a>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column align-items-center gap-3">
                        <i class="bi bi-file-earmark-check text-success" style="font-size:3rem;"></i>
                        <p class="mb-0 text-secondary">El archivo se encuentra almacenado correctamente en el sistema.</p>
                        <a href="@Url.Action("Descargar", "Archivos", new { id = Model.IdArchivo })"
                           class="btn btn-primary">
                            <i class="bi bi-download me-1"></i>Descargar Archivo
                        </a>
                    </div>
                }
            }
            else
            {
                <div class="d-flex flex-column align-items-center gap-2">
                    <i class="bi bi-file-earmark-x text-muted" style="font-size:3rem;"></i>
                    <p class="mb-0 text-muted">
                        Este registro no contiene un archivo físico o el archivo no fue encontrado.
                    </p>
                </div>
            }
        </div>
    </div>

</section>