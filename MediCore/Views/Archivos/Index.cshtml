@model IEnumerable<MediCore.EF.Archivos>
@{
    ViewBag.Title = "Archivos";
    ViewBag.ActiveMenu = "Archivos";
    bool esAdmin = (Session["NombreRol"] as string ?? "").ToUpper() == "ADMINISTRADOR";
    bool esDoctor = (Session["NombreRol"] as string ?? "").ToUpper() == "DOCTOR";
}

<div class="page-heading">
    <div>
        <span class="section-eyebrow">ARCHIVOS DIGITALES</span>
        <h3>Gestión de Archivos</h3>
    </div>
    <div>
        <a href="@Url.Action("Create", "Archivos")" class="btn btn-primary">
            <i class="bi bi-cloud-upload me-1"></i>Nuevo Archivo
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-light-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-light-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<section class="section">
    <div class="card mb-3">
        <div class="card-body">
            @using (Html.BeginForm("Index", "Archivos", FormMethod.Get))
            {
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-6">
                        <label class="form-label">Buscar archivo</label>
                        <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Nombre del archivo..." />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">Estado</label>
                        <select name="estado" class="form-select">
                            <option value="">Todos</option>
                            <option value="ACTIVO" @(ViewBag.Estado == "ACTIVO" ? "selected" : "")>ACTIVO</option>
                            <option value="INACTIVO" @(ViewBag.Estado == "INACTIVO" ? "selected" : "")>INACTIVO</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-2 d-grid">
                        <button type="submit" class="btn btn-light-secondary">
                            <i class="bi bi-funnel me-1"></i>Filtrar
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>


    <div class="card">
        <div class="card-header">
            <h4><i class="bi bi-file-earmark-medical me-2" style="color:#01C0BA;"></i>Listado de Archivos</h4>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Nombre</th>
                            <th>Tipo / MIME</th>
                            <th>Tamaño</th>
                            <th>Fecha Carga</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.id_archivo</td>
                                    <td class="fw-semibold">
                                        <i class="bi bi-file-earmark-pdf text-danger me-1"></i>@item.nombre
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(item.tipo_mime) ? "N/A" : item.tipo_mime)</td>
                                    <td>
                                        @if (item.tamano_bytes > 0)
                                        {
                                            @(item.tamano_bytes >= 1048576
                                                ? string.Format("{0:F2} MB", (double)item.tamano_bytes / 1048576)
                                                : string.Format("{0:F2} KB", (double)item.tamano_bytes / 1024))
                                        }
                                        else
                                        {
                                            <span>0 Bytes</span>
                                        }
                                    </td>
                                    <td>@item.fecha_carga.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if (item.estado == "ACTIVO")
                                        {
                                            <span class="badge-status done"><i class="bi bi-check-circle"></i>Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge-status canceled"><i class="bi bi-slash-circle"></i>Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a href="@Url.Action("Details", "Archivos", new { id = item.id_archivo })" class="btn btn-action btn-light-secondary" title="Ver detalle">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (esAdmin)
                                        {
                                        <a href="@Url.Action("Edit", "Archivos", new { id = item.id_archivo })" class="btn btn-action btn-light-primary" title="Editar archivo">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        using (Html.BeginForm("CambiarEstado", "Archivos", FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.id_archivo" />
                                            <input type="hidden" name="nuevoEstado" value="@(item.estado == "ACTIVO" ? "INACTIVO" : "ACTIVO")" />
                                            <button type="submit"
                                                    class="btn btn-action @(item.estado == "ACTIVO" ? "btn-light-danger" : "btn-light-success")"
                                                    title="@(item.estado == "ACTIVO" ? "Desactivar" : "Activar")">
                                                <i class="bi @(item.estado == "ACTIVO" ? "bi-toggle-off" : "bi-toggle-on")"></i>
                                            </button>
                                        }
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="empty-state-cell">
                                    <div class="empty-state">
                                        <div class="empty-state-icon-wrap">
                                            <i class="bi bi-file-earmark-x"></i>
                                        </div>
                                        <p class="empty-state-title">Sin archivos registrados</p>
                                        <p class="empty-state-sub">No hay archivos que coincidan con los filtros aplicados.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>