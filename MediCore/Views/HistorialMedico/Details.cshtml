@model MediCore.EF.HistorialMedico
@{
    ViewBag.Title = "Detalle de Consulta";
    ViewBag.ActiveMenu = "HistorialMedico";
}

<div class="page-heading">
    <div>
        <span class="section-eyebrow">HISTORIAL CLÍNICO</span>
        <h3>Detalle de Consulta</h3>
    </div>
    <div>
        <a href="@Url.Action("Index", "HistorialMedico")" class="btn btn-light-secondary">
            <i class="bi bi-arrow-left me-1"></i>Regresar
        </a>
    </div>
</div>


<section class="section">

    <div class="card mb-4">
        <div class="card-header">
            <h4><i class="bi bi-person-vcard me-2" style="color:#01C0BA;"></i>Información del Paciente</h4>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4 mb-3">

                    <small class="text-muted">
                        Paciente
                    </small>

                    <div class="fw-bold">
                        @Model.Expedientes.Pacientes.nombre_completo
                    </div>

                </div>


                <div class="col-md-4 mb-3">

                    <small class="text-muted">
                        Cédula
                    </small>

                    <div class="fw-bold">
                        @Model.Expedientes.Pacientes.cedula
                    </div>

                </div>


                <div class="col-md-4 mb-3">

                    <small class="text-muted">
                        Sexo
                    </small>

                    <div class="fw-bold">
                        @Model.Expedientes.Pacientes.sexo
                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="card mb-4">
        <div class="card-header">
            <h4><i class="bi bi-calendar-check me-2" style="color:#01C0BA;"></i>Información de la Consulta</h4>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4 mb-3">

                    <small class="text-muted">
                        Fecha de consulta
                    </small>

                    <div class="fw-bold">
                        @Model.fecha_consulta.ToString("dd/MM/yyyy HH:mm")
                    </div>

                </div>


                <div class="col-md-4 mb-3">

                    <small class="text-muted">
                        Doctor
                    </small>

                    <div class="fw-bold">
                        @Model.Doctores.nombre_completo
                    </div>

                </div>


                <div class="col-md-4 mb-3">

                    <small class="text-muted">
                        Especialidad
                    </small>

                    <div class="fw-bold">
                        @Model.Doctores.Especialidades.nombre
                    </div>

                </div>

            </div>


            <div class="row">

                <div class="col-md-4 mb-3">

                    <small class="text-muted">
                        Número de expediente
                    </small>

                    <div class="fw-bold">
                        #@Model.id_expediente
                    </div>

                </div>


                <div class="col-md-4 mb-3">

                    <small class="text-muted">
                        Número de cita
                    </small>

                    <div class="fw-bold">

                        @if (Model.id_cita.HasValue)
                        {
                            <span>#@Model.id_cita.Value</span>
                        }
                        else
                        {
                            <span class="text-muted">
                                No asociada
                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="card mb-4">
        <div class="card-header">
            <h4><i class="bi bi-clipboard2-pulse me-2" style="color:#01C0BA;"></i>Información Clínica</h4>
        </div>


        <div class="card-body">

            <!-- SÍNTOMAS -->

            <div class="mb-4">

                <h6>
                    <i class="bi bi-thermometer-half me-1"></i>
                    Síntomas
                </h6>

                <div class="border rounded p-3">

                    @if (!string.IsNullOrWhiteSpace(Model.sintomas))
                    {
                        @Model.sintomas
                    }
                    else
                    {
                        <span class="text-muted">
                            No se registraron síntomas.
                        </span>
                    }

                </div>

            </div>


            <!-- DIAGNÓSTICO -->

            <div class="mb-4">

                <h6>
                    <i class="bi bi-clipboard-check me-1"></i>
                    Diagnóstico
                </h6>

                <div class="border rounded p-3">

                    <strong>
                        @Model.diagnostico
                    </strong>

                </div>

            </div>


            <!-- TRATAMIENTO -->

            <div class="mb-4">

                <h6>
                    <i class="bi bi-heart-pulse me-1"></i>
                    Tratamiento indicado
                </h6>

                <div class="border rounded p-3">

                    @if (!string.IsNullOrWhiteSpace(Model.tratamiento))
                    {
                        @Model.tratamiento
                    }
                    else
                    {
                        <span class="text-muted">
                            No se registró tratamiento.
                        </span>
                    }

                </div>

            </div>


            <div class="row">

                <!-- MEDICAMENTOS -->

                <div class="col-md-6 mb-4">

                    <h6>
                        <i class="bi bi-capsule me-1"></i>
                        Medicamentos
                    </h6>

                    <div class="border rounded p-3 h-100">

                        @if (!string.IsNullOrWhiteSpace(Model.medicamentos))
                        {
                            @Model.medicamentos
                        }
                        else
                        {
                            <span class="text-muted">
                                No se recetaron medicamentos.
                            </span>
                        }

                    </div>

                </div>


                <!-- OBSERVACIONES -->

                <div class="col-md-6 mb-4">

                    <h6>
                        <i class="bi bi-journal-text me-1"></i>
                        Observaciones
                    </h6>

                    <div class="border rounded p-3 h-100">

                        @if (!string.IsNullOrWhiteSpace(Model.observaciones))
                        {
                            @Model.observaciones
                        }
                        else
                        {
                            <span class="text-muted">
                                No se registraron observaciones.
                            </span>
                        }

                    </div>

                </div>

            </div>


            <!-- PRÓXIMA CITA -->

            <div>

                <h6>
                    <i class="bi bi-calendar-event me-1"></i>
                    Próxima cita de control
                </h6>

                <div class="border rounded p-3">

                    @if (Model.proxima_cita.HasValue)
                    {
                        <span class="fw-bold">
                            @Model.proxima_cita.Value.ToString("dd/MM/yyyy")
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">
                            No se indicó una próxima cita.
                        </span>
                    }

                </div>

            </div>

        </div>

    </div>


    <div class="d-flex gap-2 justify-content-end">
        <a href="@Url.Action("Details", "Expedientes", new { id = Model.id_expediente })" class="btn btn-light-secondary">
            <i class="bi bi-folder2-open me-1"></i>Ver Expediente
        </a>
        <a href="@Url.Action("Index", "HistorialMedico")" class="btn btn-light-secondary">
            <i class="bi bi-arrow-left me-1"></i>Volver al Historial
        </a>
    </div>

</section>