@model MediCore.Models.CitaFormModel
@{
    ViewBag.Title = "Editar Cita";
    ViewBag.ActiveMenu = "Citas";
}

<div class="page-heading">
    <div>
        <span class="section-eyebrow">GESTIÓN MÉDICA</span>
        <h3>Editar Cita</h3>
    </div>
    <div>
        <a href="@Url.Action("Index", "Citas")" class="btn btn-light-secondary">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
    </div>
</div>

<section class="section">
    <div class="card">
        <div class="card-header">
            <h4><i class="bi bi-calendar2-check me-2" style="color:#01C0BA;"></i>Información de la Cita</h4>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("Edit", "Citas", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.IdCita)
                <span id="citas-init-data" data-doctor="@Model.IdDoctor" data-fecha="@Model.Fecha.ToString("yyyy-MM-dd")" data-hora="@Model.Hora.ToString(@"hh\:mm")"></span>
                @Html.ValidationSummary(true, "", new { @class = "alert alert-light-danger" })

                <div class="row">
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.IdPaciente)
                        @Html.DropDownListFor(m => m.IdPaciente, Model.Pacientes, "-- Seleccione un paciente --", new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.IdPaciente, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.IdEspecialidad)
                        @Html.DropDownListFor(m => m.IdEspecialidad, Model.Especialidades, "-- Seleccione una especialidad --", new { @class = "form-select", id = "IdEspecialidad" })
                        @Html.ValidationMessageFor(m => m.IdEspecialidad, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.IdDoctor)
                        @Html.DropDownListFor(m => m.IdDoctor, Model.Doctores, "-- Seleccione un doctor --", new { @class = "form-select", id = "IdDoctor" })
                        @Html.ValidationMessageFor(m => m.IdDoctor, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.Fecha)
                        <select name="Fecha" id="Fecha" class="form-select">
                            <option value="">-- Seleccione un doctor primero --</option>
                        </select>
                        @Html.ValidationMessageFor(m => m.Fecha, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label>Hora Disponible</label>
                        <select name="Hora" id="Hora" class="form-select">
                            <option value="">-- Seleccione una hora --</option>
                        </select>
                        @Html.ValidationMessageFor(m => m.Hora, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.DuracionMinutos)
                        @Html.TextBoxFor(m => m.DuracionMinutos, new { @class = "form-control", @readonly = "readonly", id = "Duracion" })
                    </div>
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Motivo)
                    @Html.TextAreaFor(m => m.Motivo, new { @class = "form-control", rows = 4 })
                    @Html.ValidationMessageFor(m => m.Motivo, "", new { @class = "text-danger small" })
                </div>

                <div class="text-end">
                    <a href="@Url.Action("Index", "Citas")" class="btn btn-light-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Actualizar Cita</button>
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/citas.js?v=@System.IO.File.GetLastWriteTime(Server.MapPath("~/Scripts/citas.js")).Ticks"></script>
}