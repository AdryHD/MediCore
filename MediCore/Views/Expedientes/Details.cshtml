
@model MediCore.EF.Expedientes

@{
    ViewBag.Title = "Detalle del Expediente";
}

<div class="page-heading">

    <div>
        <span class="section-eyebrow">
            EXPEDIENTE CLÍNICO
        </span>

        <h3>@Model.Pacientes.nombre_completo</h3>

        <p class="text-subtitle text-muted mb-0">
            Información general y clínica del paciente.
        </p>
    </div>

    <div>
        <a href="@Url.Action("Index", "Expedientes")"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Regresar

        </a>

        <a href="@Url.Action("Edit", "Expedientes",
                  new { id = Model.id_expediente })"
           class="btn btn-primary">

            <i class="bi bi-pencil-square me-1"></i>
            Editar Expediente

        </a>
    </div>

</div>


<section class="section">

    <!-- DATOS DEL PACIENTE -->

    <div class="card mb-4">

        <div class="card-header">
            <h4 class="card-title">
                <i class="bi bi-person-vcard me-2"></i>
                Datos del Paciente
            </h4>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4 mb-3">
                    <small class="text-muted">Nombre completo</small>
                    <div class="fw-bold">
                        @Model.Pacientes.nombre_completo
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <small class="text-muted">Cédula</small>
                    <div class="fw-bold">
                        @Model.Pacientes.cedula
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <small class="text-muted">Fecha de nacimiento</small>
                    <div class="fw-bold">
                        @Model.Pacientes.fecha_nacimiento.ToString("dd/MM/yyyy")
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <small class="text-muted">Sexo</small>
                    <div class="fw-bold">
                        @Model.Pacientes.sexo
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <small class="text-muted">Teléfono</small>
                    <div class="fw-bold">
                        @(string.IsNullOrWhiteSpace(Model.Pacientes.telefono)
                            ? "No registrado"
                            : Model.Pacientes.telefono)
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <small class="text-muted">Correo electrónico</small>
                    <div class="fw-bold">
                        @(string.IsNullOrWhiteSpace(Model.Pacientes.correo)
                            ? "No registrado"
                            : Model.Pacientes.correo)
                    </div>
                </div>

                <div class="col-12">
                    <small class="text-muted">Dirección</small>
                    <div class="fw-bold">
                        @(string.IsNullOrWhiteSpace(Model.Pacientes.direccion)
                            ? "No registrada"
                            : Model.Pacientes.direccion)
                    </div>
                </div>

            </div>

        </div>

    </div>


    <!-- INFORMACIÓN CLÍNICA -->

    <div class="card mb-4">

        <div class="card-header">
            <h4 class="card-title">
                <i class="bi bi-heart-pulse me-2"></i>
                Información Clínica
            </h4>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4 mb-3">

                    <small class="text-muted">
                        Tipo de sangre
                    </small>

                    <div class="mt-1">

                        @if (!string.IsNullOrWhiteSpace(Model.tipo_sangre))
                        {
                            <span class="badge bg-danger fs-6">
                                @Model.tipo_sangre
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">
                                No registrado
                            </span>
                        }

                    </div>

                </div>


                <div class="col-md-4 mb-3">

                    <small class="text-muted">
                        Fecha de apertura
                    </small>

                    <div class="fw-bold">
                        @Model.fecha_apertura.ToString("dd/MM/yyyy")
                    </div>

                </div>


                <div class="col-md-4 mb-3">

                    <small class="text-muted">
                        Consultas registradas
                    </small>

                    <div>
                        <span class="badge bg-primary fs-6">
                            @Model.HistorialMedico.Count
                        </span>
                    </div>

                </div>

            </div>


            <hr />


            <div class="mb-4">

                <h6>
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    Alergias
                </h6>

                <p class="mb-0">
                    @(string.IsNullOrWhiteSpace(Model.alergias)
                        ? "No se han registrado alergias."
                        : Model.alergias)
                </p>

            </div>


            <div>

                <h6>
                    <i class="bi bi-clipboard2-pulse me-1"></i>
                    Antecedentes médicos
                </h6>

                <p class="mb-0">
                    @(string.IsNullOrWhiteSpace(Model.antecedentes)
                        ? "No se han registrado antecedentes médicos."
                        : Model.antecedentes)
                </p>

            </div>

        </div>

    </div>


    <!-- HISTORIAL MÉDICO -->

    <div class="card">

        <div class="card-header">

            <h4 class="card-title">
                <i class="bi bi-clock-history me-2"></i>
                Historial Médico
            </h4>

        </div>

        <div class="card-body">

            @if (Model.HistorialMedico != null &&
                 Model.HistorialMedico.Any())
            {
                <div class="table-responsive">

                    <table class="table table-striped table-hover">

                        <thead class="table-light">

                            <tr>
                                <th>Fecha</th>
                                <th>Doctor</th>
                                <th>Diagnóstico</th>
                                <th>Próxima cita</th>
                                <th class="text-center">Acciones</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var historial in
                                Model.HistorialMedico
                                    .OrderByDescending(h => h.fecha_consulta))
                            {
                                <tr>

                                    <td>
                                        @historial.fecha_consulta
                                        .ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        @historial.Doctores.nombre_completo
                                    </td>

                                    <td>
                                        @historial.diagnostico
                                    </td>

                                    <td>
                                        @if (historial.proxima_cita.HasValue)
                                        {
                                            @historial.proxima_cita.Value.ToString("dd/MM/yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No indicada
                                            </span>
                                        }
                                        }
                                    </td>

                                    <td class="text-center">

                                        <button type="button"
                                                class="btn btn-sm btn-info"
                                                disabled
                                                title="El detalle de la consulta se habilitará con Historial Médico">

                                            <i class="bi bi-eye"></i>

                                        </button>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">

                    <i class="bi bi-clipboard2-x fs-1"></i>

                    <p class="mt-2 mb-0">
                        Este paciente todavía no tiene consultas
                        registradas en su historial médico.
                    </p>

                </div>
            }

        </div>

    </div>

</section>