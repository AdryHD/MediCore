@model IEnumerable<MediCore.Models.ExpedienteListaModel>
@{
    ViewBag.Title = "Expedientes";
    ViewBag.ActiveMenu = "Expedientes";
    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 0;
}

<div class="page-heading">
    <div>
        <span class="section-eyebrow">EXPEDIENTES</span>
        <h3>Expedientes Clínicos</h3>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-light-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-light-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}


<section class="section">
    <div class="card mb-3">
        <div class="card-body">
            @using (Html.BeginForm("Index", "Expedientes", FormMethod.Get))
            {
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-6">
                        <label class="form-label">Buscar paciente</label>
                        <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Nombre o cédula" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">Tipo de sangre</label>
                        <select name="tipoSangre" class="form-select">
                            <option value="">Todos</option>
                            <option value="A+">A+</option>
                            <option value="A-">A-</option>
                            <option value="B+">B+</option>
                            <option value="B-">B-</option>
                            <option value="AB+">AB+</option>
                            <option value="AB-">AB-</option>
                            <option value="O+">O+</option>
                            <option value="O-">O-</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-2 d-grid">
                        <button type="submit" class="btn btn-light-secondary">
                            <i class="bi bi-funnel me-1"></i>Filtrar
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>


    <div class="card">
        <div class="card-header">
            <h4><i class="bi bi-folder2-open me-2" style="color:#01C0BA;"></i>Listado de Expedientes</h4>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Paciente</th>
                            <th>Cédula</th>
                            <th>Tipo de sangre</th>
                            <th>Fecha de apertura</th>
                            <th>Consultas</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.IdExpediente</td>
                                    <td class="fw-semibold">@item.NombrePaciente</td>
                                    <td>@item.CedulaPaciente</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.TipoSangre))
                                        {
                                            <span class="badge-status pending"><i class="bi bi-droplet-fill"></i>@item.TipoSangre</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>@item.FechaApertura.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="badge-status done"><i class="bi bi-clipboard2-pulse"></i>@item.ConsultasCount</span>
                                    </td>
                                    <td class="text-end">
                                        <a href="@Url.Action("Details", "Expedientes", new { id = item.IdExpediente })" class="btn btn-action btn-light-secondary" title="Ver expediente">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="@Url.Action("Edit", "Expedientes", new { id = item.IdExpediente })" class="btn btn-action btn-light-primary" title="Editar expediente">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="empty-state-cell">
                                    <div class="empty-state">
                                        <div class="empty-state-icon-wrap">
                                            <i class="bi bi-folder-x"></i>
                                        </div>
                                        <p class="empty-state-title">Sin expedientes registrados</p>
                                        <p class="empty-state-sub">No hay expedientes que coincidan con los filtros aplicados.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (totalPaginas > 1)
        {
            <div class="card-footer">
                <nav aria-label="Paginación de expedientes">
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", "Expedientes", new { buscar = ViewBag.Buscar, tipoSangre = ViewBag.TipoSangre, page = paginaActual - 1 })">Anterior</a>
                        </li>
                        @for (int i = 1; i <= totalPaginas; i++)
                        {
                            <li class="page-item @(i == paginaActual ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", "Expedientes", new { buscar = ViewBag.Buscar, tipoSangre = ViewBag.TipoSangre, page = i })">@i</a>
                            </li>
                        }
                        <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", "Expedientes", new { buscar = ViewBag.Buscar, tipoSangre = ViewBag.TipoSangre, page = paginaActual + 1 })">Siguiente</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</section>