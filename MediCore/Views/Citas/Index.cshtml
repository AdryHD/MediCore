@model IEnumerable<MediCore.EF.Citas>
@{
    ViewBag.Title = "Gestión de Citas";
    ViewBag.ActiveMenu = "Citas";
}

<div class="page-heading">
    <div>
        <span class="section-eyebrow">GESTIÓN MÉDICA</span>
        <h3>Citas</h3>
    </div>
    <div>
        <a href="@Url.Action("Create", "Citas")" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Nueva Cita
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-light-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-light-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<section class="section">
    <div class="card mb-3">
        <div class="card-body">
            @using (Html.BeginForm("Index", "Citas", FormMethod.Get))
            {
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-3">
                        <label class="form-label">Paciente</label>
                        @Html.DropDownList("idPaciente", (IEnumerable<SelectListItem>)ViewBag.Pacientes, "Todos", new { @class = "form-select" })
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label">Doctor</label>
                        @Html.DropDownList("idDoctor", (IEnumerable<SelectListItem>)ViewBag.Doctores, "Todos", new { @class = "form-select" })
                    </div>
                    <div class="col-12 col-md-2">
                        <label class="form-label">Estado</label>
                        <select name="estado" class="form-select">
                            <option value="">Todos</option>
                            <option value="PENDIENTE">Pendiente</option>
                            <option value="ATENDIDA">Atendida</option>
                            <option value="CANCELADA">Cancelada</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-2">
                        <label class="form-label">Fecha</label>
                        <input type="date" name="fecha" class="form-control" />
                    </div>
                    <div class="col-12 col-md-2 d-grid">
                        <button type="submit" class="btn btn-light-secondary">
                            <i class="bi bi-funnel me-1"></i>Filtrar
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h4><i class="bi bi-calendar2-check me-2" style="color:#01C0BA;"></i>Listado de Citas</h4>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Paciente</th>
                            <th>Doctor</th>
                            <th>Fecha</th>
                            <th>Duración</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.id_cita</td>
                                    <td class="fw-semibold">@item.Pacientes.nombre_completo</td>
                                    <td>@item.Doctores.nombre_completo</td>
                                    <td>@item.fecha_cita.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@item.duracion_min min</td>
                                    <td>
                                        @{
                                            string badgeClass, badgeIcon, badgeText;
                                            switch (item.estado?.ToUpper())
                                            {
                                                case "PENDIENTE":
                                                    badgeClass = "pending"; badgeIcon = "bi-hourglass-split"; badgeText = "Pendiente"; break;
                                                case "ATENDIDA":
                                                    badgeClass = "done"; badgeIcon = "bi-check-circle-fill"; badgeText = "Atendida"; break;
                                                case "CANCELADA":
                                                    badgeClass = "canceled"; badgeIcon = "bi-slash-circle"; badgeText = "Cancelada"; break;
                                                case "CONFIRMADA":
                                                    badgeClass = "confirmed"; badgeIcon = "bi-check2-circle"; badgeText = "Confirmada"; break;
                                                case "PROGRAMADA":
                                                    badgeClass = "programmed"; badgeIcon = "bi-calendar-check"; badgeText = "Programada"; break;
                                                default:
                                                    badgeClass = "pending"; badgeIcon = "bi-circle"; badgeText = item.estado?.ToLower() ?? "—"; break;
                                            }
                                        }
                                        <span class="badge-status @badgeClass"><i class="bi @badgeIcon"></i>@badgeText</span>
                                    </td>
                                    <td class="text-end">
                                        @if (item.estado == "PENDIENTE")
                                        {
                                            <a href="@Url.Action("Details", "Citas", new { id = item.id_cita })" class="btn btn-action btn-light-secondary" title="Ver detalle">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a href="@Url.Action("Edit", "Citas", new { id = item.id_cita })" class="btn btn-action btn-light-primary" title="Editar">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a href="@Url.Action("Atender", "Citas", new { id = item.id_cita })" class="btn btn-action btn-light-success" title="Atender">
                                                <i class="bi bi-heart-pulse-fill"></i>
                                            </a>
                                            <a href="@Url.Action("Cancelar", "Citas", new { id = item.id_cita })" class="btn btn-action btn-light-danger btn-confirmar-cancelar" title="Cancelar"
                                               data-cita-id="@item.id_cita">
                                                <i class="bi bi-x-circle"></i>
                                            </a>
                                        }
                                        else if (item.estado == "ATENDIDA")
                                        {
                                            <a href="@Url.Action("Details", "Citas", new { id = item.id_cita })" class="btn btn-action btn-light-secondary" title="Ver">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a href="@Url.Action("Index", "Expedientes", new { idCita = item.id_cita })" class="btn btn-action btn-light-primary" title="Ver expediente">
                                                <i class="bi bi-folder2-open"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("Details", "Citas", new { id = item.id_cita })" class="btn btn-action btn-light-secondary" title="Ver">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="empty-state-cell">
                                    <div class="empty-state">
                                        <div class="empty-state-icon-wrap">
                                            <i class="bi bi-calendar2-x"></i>
                                        </div>
                                        <p class="empty-state-title">Sin citas registradas</p>
                                        <p class="empty-state-sub">No hay citas que coincidan con los filtros aplicados.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="mcCancelarModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content mc-modal">
            <div class="modal-body text-center">
                <div class="mc-modal-icon-wrap danger">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <h5 class="mc-modal-title">¿Cancelar cita?</h5>
                <p class="mc-modal-text">Esta acción cancelará la cita seleccionada. No podrá deshacerse.</p>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-light-secondary" data-bs-dismiss="modal">Volver</button>
                <a href="#" id="mcCancelarBtn" class="btn btn-light-danger">Sí, cancelar</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-confirmar-cancelar').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                var url = btn.getAttribute('href');
                document.getElementById('mcCancelarBtn').setAttribute('href', url);
                new bootstrap.Modal(document.getElementById('mcCancelarModal')).show();
            });
        });
    </script>
}