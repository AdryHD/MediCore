@model IEnumerable<MediCore.EF.HistorialMedico>
@{
    ViewBag.Title = "Historial Médico";
    ViewBag.ActiveMenu = "HistorialMedico";
}

<div class="page-heading">
    <div>
        <span class="section-eyebrow">HISTORIAL CLÍNICO</span>
        <h3>Historial Médico</h3>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-light-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}


<section class="section">
    <div class="card mb-3">
        <div class="card-body">
            @using (Html.BeginForm("Index", "HistorialMedico", FormMethod.Get))
            {
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-3">
                        <label class="form-label">Paciente</label>
                        @Html.DropDownList("idPaciente", (SelectList)ViewBag.Pacientes, "Todos", new { @class = "form-select" })
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label">Doctor</label>
                        @Html.DropDownList("idDoctor", (SelectList)ViewBag.Doctores, "Todos", new { @class = "form-select" })
                    </div>
                    <div class="col-12 col-md-2">
                        <label class="form-label">Especialidad</label>
                        @Html.DropDownList("idEspecialidad", (SelectList)ViewBag.Especialidades, "Todas", new { @class = "form-select" })
                    </div>
                    <div class="col-12 col-md-2">
                        <label class="form-label">Desde</label>
                        <input type="date" name="fechaDesde" class="form-control" value="@(ViewBag.FechaDesde != null ? ((DateTime)ViewBag.FechaDesde).ToString("yyyy-MM-dd") : "")" />
                    </div>
                    <div class="col-12 col-md-2">
                        <label class="form-label">Hasta</label>
                        <input type="date" name="fechaHasta" class="form-control" value="@(ViewBag.FechaHasta != null ? ((DateTime)ViewBag.FechaHasta).ToString("yyyy-MM-dd") : "")" />
                    </div>
                </div>
                <div class="row g-2 mt-1">
                    <div class="col-12 col-md-2 d-grid">
                        <button type="submit" class="btn btn-light-secondary">
                            <i class="bi bi-funnel me-1"></i>Filtrar
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>


    <div class="card">
        <div class="card-header">
            <h4><i class="bi bi-clock-history me-2" style="color:#01C0BA;"></i>Consultas Registradas</h4>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Paciente</th>
                            <th>Doctor</th>
                            <th>Especialidad</th>
                            <th>Diagnóstico</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.fecha_consulta.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="fw-semibold">@item.Expedientes.Pacientes.nombre_completo</td>
                                    <td>@item.Doctores.nombre_completo</td>
                                    <td>@item.Doctores.Especialidades.nombre</td>
                                    <td>@item.diagnostico</td>
                                    <td class="text-end">
                                        <a href="@Url.Action("Details", "HistorialMedico", new { id = item.id_historial })" class="btn btn-action btn-light-secondary" title="Ver consulta">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="empty-state-cell">
                                    <div class="empty-state">
                                        <div class="empty-state-icon-wrap">
                                            <i class="bi bi-clipboard2-x"></i>
                                        </div>
                                        <p class="empty-state-title">Sin registros encontrados</p>
                                        <p class="empty-state-sub">No se encontraron registros en el historial médico con los filtros aplicados.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>